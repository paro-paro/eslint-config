{
  "name": "@paro-paro/eslint-config",
  "version": "3.0.0",
  "description": "ESLint config for TypeScript and JavaScript, with opt-in Vue and Tailwind CSS support",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-stylistic",
    "tailwindcss",
    "typescript",
    "vue"
  ],
  "homepage": "https://github.com/paro-paro/eslint-config#readme",
  "bugs": "https://github.com/paro-paro/eslint-config/issues",
  "license": "MIT",
  "author": "Antonio Parody <aparodyg@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paro-paro/eslint-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm build && pnpm lint && pnpm fmt:check && pnpm typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "git:hooks": "simple-git-hooks",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "prepare": "pnpm git:hooks",
    "prepublishOnly": "pnpm build",
    "preview": "eslint-config-inspector",
    "release": "pnpm check && bumpp && pnpm publish",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-plugin-antfu": "^3.3.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.4.12",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-unicorn": "^80.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0",
    "vue-eslint-parser": "^10.4.2"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^3.5.0",
    "@types/node": "^24.19.2",
    "bumpp": "^10.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.4.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-better-tailwindcss": {
      "optional": true
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "oxfmt --check --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
